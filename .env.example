# Kopiere diese Datei nach .env und trage deine Werte ein.
# .env ist in .gitignore und wird NIE ins Repo gepusht.
# In Coolify trägst du dieselben Variablen unter "Environment Variables" ein.

# --- Datenbank (Pflicht) ---
# Lokal: passt zu docker-compose.yml. In Coolify: URL der Managed Database (internes Netz).
DATABASE_URL=postgresql://app:app@localhost:5432/app

# --- Login (siehe docs/03-login.md) ---
# none      = kein Login (Standard für Prototypen mit Testdaten)
# password  = ein gemeinsames Passwort für alle (APP_PASSWORD)
# authentik = Login über DRK-SSO (Produktivbetrieb)
AUTH_MODE=none

# Für AUTH_MODE=password und AUTH_MODE=authentik: zufälliger Wert, z. B. `openssl rand -base64 32`
AUTH_SECRET=

# Nur für AUTH_MODE=password
APP_PASSWORD=

# Nur für AUTH_MODE=authentik (Werte kommen vom Admin, der den Provider in Authentik anlegt)
AUTH_AUTHENTIK_ID=
AUTH_AUTHENTIK_SECRET=
AUTH_AUTHENTIK_ISSUER=https://auth.drk-digital.io/application/o/<app-slug>
